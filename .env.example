# Copy to .env and adjust. Never commit .env.

# SQLite database file (relative paths resolve from the project root).
SMART_SHIELD_DB_PATH=data/smart_shield.db

# Where registered intrusion datasets (uploaded CSVs) are stored.
SMART_SHIELD_DATASET_DIR=data/datasets

# Where trained model artifacts are written. Only registered artifacts with a matching SHA-256 are loaded.
SMART_SHIELD_ARTIFACT_DIR=artifacts

# Sign the user out after this many minutes without any interaction.
SMART_SHIELD_SESSION_IDLE_MINUTES=30

# Lock sign-in for an email after this many failures inside the lockout window.
SMART_SHIELD_LOCKOUT_MAX_ATTEMPTS=5
SMART_SHIELD_LOCKOUT_MINUTES=15

# Allow self-registration after the first (admin) account exists. New accounts are analysts.
SMART_SHIELD_ALLOW_SELF_REGISTRATION=true

# Python logging level: DEBUG, INFO, WARNING, ERROR.
SMART_SHIELD_LOG_LEVEL=INFO
